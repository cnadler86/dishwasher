[Unit]
Description=Dishwasher Energy Optimization Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{WORKING_DIR}}
ExecStart={{PYTHON_BIN}} {{WORKING_DIR}}/dishwasher_controller.py

# Restart configuration
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Timeout for stopping the service (10 seconds)
TimeoutStopSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dishwasher-controller

# Resource limits
MemoryMax=25M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
